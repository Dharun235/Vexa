start: (_NL | command _NL)* command?
?command: "load" ESCAPED_STRING -> load
        | "detect" target ("confidence" NUMBER)? -> detect
        | "segment" "detections" -> segment
        | "count" "masks" -> count_masks
        | "draw" "masks" -> draw_masks
        | "scan" "codes" -> scan_codes
        | "find" "text" ESCAPED_STRING -> find_text
        | "inspect" "image" -> inspect_image
        | "check" "blur" -> check_blur
        | "count" "text" -> count_text
        | "count" target -> count
        | "draw" "boxes" -> draw
        | "draw" "text" -> draw_text
        | "ocr" -> ocr
        | "print" ESCAPED_STRING -> print_text
        | "print" "text" -> print_ocr
        | "print" "masks" -> count_masks
        | "print" NAME -> print_count
        | "show" "image" -> show
?target: NAME -> bare_target
       | ESCAPED_STRING -> quoted_target
NAME: /[a-zA-Z][a-zA-Z0-9_]*/
_NL: /\r?\n/
%import common.NUMBER
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
%ignore /#[^\n]*/
