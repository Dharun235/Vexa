start: _NL* (_statement _NL*)*
_statement: command _NL | block
?block: "if" expr _NL body elif* ("else" _NL body)? "end" _NL -> if_block
      | "for" "each" NAME "in" expr _NL body "end" _NL -> for_objects
      | "define" NAME params? _NL body "end" _NL -> define
      | "for" "each" "image" "in" ESCAPED_STRING _NL body "end" _NL -> for_each
      | "for" "each" "frame" "in" ESCAPED_STRING ("every" NUMBER ("second" | "seconds"))? _NL body "end" _NL -> for_frames
body: _NL* (_statement _NL*)*
elif: "else" "if" expr _NL body
params: "(" [param ("," param)*] ")"
param: NAME (":" NAME)?

// Expressions, loosest binding first
?expr: or_expr
     | or_expr "where" or_expr -> where
?or_expr: and_expr
        | or_expr "or" and_expr -> or_op
?and_expr: not_expr
         | and_expr "and" not_expr -> and_op
?not_expr: comparison
         | "not" not_expr -> not_op
?comparison: sum
           | sum COMPARE sum -> compare
?sum: product
    | sum "+" product -> add
    | sum "-" product -> subtract
?product: unary
        | product "*" unary -> multiply
        | product "/" unary -> divide
        | product "%" unary -> modulo
?unary: postfix
      | "-" unary -> negate
?postfix: atom
        | postfix "." NAME -> attribute
?atom: NUMBER -> number
     | ESCAPED_STRING -> string
     | "true" -> true
     | "false" -> false
     | NAME -> variable
     | NAME "(" [expr ("," expr)*] ")" -> call
     | "(" expr ")"
     | "count" subject -> count_value
     | "text" "contains" ESCAPED_STRING -> text_contains
     | "caption" "contains" ESCAPED_STRING -> caption_contains
     | "caption" -> caption_value
     | "image" QUALITY -> image_quality
     | "detections" -> detections
     | pick_word postfix -> pick
!pick_word: "first" | "last" | "largest" | "smallest" | "nearest" | "farthest"
?subject: target
        | "text" -> text_subject
        | "masks" -> masks_subject
        | "codes" -> codes_subject
        | "pose" target -> pose_subject
        | ("colour" | "color") NAME target -> colour_subject
        | target "in" AREA -> area_subject
        | target RELATION target -> relation_subject
?command: "load" ESCAPED_STRING -> load
        | "let" NAME "=" expr -> let
        | "record" NAME "=" expr -> record_value
        | "return" expr? -> return
        | NAME ("(" [expr ("," expr)*] ")")? -> call_statement
        | "draw" target -> draw_objects
        | "detect" target ("confidence" NUMBER)? -> detect
        | "segment" "detections" -> segment
        | "count" "masks" -> count_masks
        | "draw" "masks" -> draw_masks
        | "draw" "depth" -> draw_depth
        | "estimate" "depth" -> estimate_depth
        | "estimate" "poses" -> estimate_poses
        | "blur" target -> blur
        | "caption" "detailed" -> caption_detailed
        | "caption" -> caption
        | "record" "caption" -> record_caption
        | "locate" target -> locate
        | "pixelate" target -> pixelate
        | "count" "pose" target -> count_pose
        | "draw" "poses" -> draw_poses
        | "record" "poses" -> record_poses
        | "rank" target "by" "distance" -> rank_distance
        | "record" "distances" -> record_distances
        | "export" "points" ESCAPED_STRING -> export_points
        | "scan" "codes" -> scan_codes
        | ("colour" | "color") target -> colour
        | "record" ("colours" | "colors") -> record_colours
        | "count" ("colour" | "color") NAME target -> count_colour
        | "count" target "in" AREA -> count_area
        | "count" target RELATION target -> count_relation
        | "where" target -> where
        | "remove" "background" -> remove_background
        | "check" "exposure" -> check_exposure
        | "find" "text" ESCAPED_STRING -> find_text
        | "inspect" "image" -> inspect_image
        | "check" "blur" -> check_blur
        | "count" "text" -> count_text
        | "count" target -> count
        | "draw" "boxes" -> draw
        | "draw" "text" -> draw_text
        | "ocr" -> ocr
        | "print" "text" -> print_ocr
        | "print" "masks" -> count_masks
        | "print" expr -> print_value
        | "show" "image" -> show
        | "record" "count" subject -> record_count
        | "record" "text" -> record_text
        | "record" "codes" -> record_codes
        | "save" "csv" ESCAPED_STRING -> save_csv
        | "record" "measurements" -> record_measurements
        | "reference" target NUMBER UNIT -> reference
        | "measure" "gap" "between" target "and" target -> measure_gap
        | "measure" target -> measure
        | "rotate" SIGNED_NUMBER -> rotate
        | "flip" "horizontal" -> flip_horizontal
        | "flip" "vertical" -> flip_vertical
        | "resize" NUMBER NUMBER -> resize
        | "scale" NUMBER -> scale
        | "crop" NUMBER NUMBER NUMBER NUMBER -> crop
        | "move" SIGNED_NUMBER SIGNED_NUMBER -> move
        | "style" target -> style
        | "translate" target "to" target -> translate
?target: NAME -> bare_target
       | ESCAPED_STRING -> quoted_target
COMPARE: "<=" | ">=" | "==" | "!=" | "<" | ">"
UNIT: "mm" | "cm" | "m"
AREA: "left" | "right" | "top" | "bottom" | "centre" | "center"
RELATION: /(left|right)[ \t]+of|above|below/
QUALITY: "blurry" | "dark" | "bright"
NAME: /[a-zA-Z][a-zA-Z0-9_]*/
_NL: /\r?\n/
%import common.NUMBER
%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
%ignore /#[^\n]*/
