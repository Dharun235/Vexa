{
  "name": "vexa",
  "displayName": "Vexa",
  "description": "Vexa computer-vision language: highlighting, live checking, completion, hover help and formatting",
  "version": "0.1.0",
  "publisher": "dharun235",
  "license": "MIT",
  "repository": "https://github.com/Dharun235/Vexa",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "activationEvents": ["onLanguage:vexa"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vexa",
        "aliases": ["Vexa", "vexa"],
        "extensions": [".vexa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "vexa", "scopeName": "source.vexa", "path": "./syntaxes/vexa.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Vexa",
      "properties": {
        "vexa.path": {
          "type": "string",
          "default": "vexa",
          "description": "The vexa command; the extension runs \"vexa lsp\"."
        }
      }
    }
  }
}
