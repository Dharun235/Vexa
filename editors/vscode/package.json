{
  "name": "vexa",
  "displayName": "Vexa Language",
  "description": "Language support for Vexa, a small language for computer vision: highlighting, live errors and warnings, completion, hover, go to definition, rename, outline and formatting",
  "version": "0.2.1",
  "publisher": "dharun235",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e30",
    "theme": "dark"
  },
  "homepage": "https://github.com/Dharun235/Vexa#readme",
  "repository": "https://github.com/Dharun235/Vexa",
  "bugs": {
    "url": "https://github.com/Dharun235/Vexa/issues"
  },
  "keywords": [
    "vexa",
    "computer vision",
    "dsl",
    "language server",
    "image"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:vexa"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vexa",
        "aliases": [
          "Vexa",
          "vexa"
        ],
        "extensions": [
          ".vexa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vexa",
        "scopeName": "source.vexa",
        "path": "./syntaxes/vexa.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Vexa",
      "properties": {
        "vexa.path": {
          "type": "string",
          "default": "vexa",
          "description": "The vexa command; the extension runs \"vexa lsp\"."
        }
      }
    },
    "commands": [
      {
        "command": "vexa.restartServer",
        "title": "Vexa: Restart Language Server"
      }
    ]
  }
}
